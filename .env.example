# Azure OpenAI Configuration
# Required. app/core/llm_provider.py builds the Azure client from these five
# values when LLM_PROVIDER=azure (see below). AZURE_OPENAI_DEPLOYMENT is the
# deployment name chosen when the Azure resource was provisioned - it is
# often NOT the model name. A wrong value here returns a 404 that reads like
# a model problem.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# REQUIRED - the one value you must change. Ask the project owner for a key.
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# Not read by app/core/config.py today - pydantic silently ignores it
# (extra="ignore"). Kept for a human reading this file and for a future
# reader of the deployment's name; safe to leave as-is.
AZURE_OPENAI_MODEL_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure Storage Configuration (Optional)
# Only needed if the app is wired to Azure Blob Storage. Leave blank for
# local-disk storage (see STORAGE_ROOT, which has its own default and does
# not need an env entry - app/core/storage.py).
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=

# Required. Selects which LLM client app/core/llm_provider.py builds:
# "groq" or "azure". This project runs on "azure".
LLM_PROVIDER=azure

# Real Outlook sending. Blank sender addresses mean "use whichever Outlook
# account this machine is signed in as" - so this file is portable between
# machines. Set to "simulated" to stop anything leaving the machine.
# NOTE: run scripts/seed_demo.py with CALENDAR_BACKEND=simulated - the
# interview-schedule guard rejects seeded fictional actors in real mode.
# Optional - all four already default to "simulated" / blank, matching the
# lines below, if this whole block is left out of .env entirely.
EMAIL_BACKEND=simulated
# Leave blank - Outlook sends as whoever is signed in on this machine.
EMAIL_SENDER_ADDRESS=
CALENDAR_BACKEND=simulated
# Leave blank - same reason as EMAIL_SENDER_ADDRESS.
CALENDAR_SENDER_EMAIL=

# Sarvam TTS (Optional). Only used by scripts/demo_video/ to generate the
# narration audio track for the recruiter demo video — not read by the
# FastAPI app. Get a key at https://dashboard.sarvam.ai.
SARVAM_API_KEY=
SARVAM_SPEAKER=ritu
SARVAM_TARGET_LANGUAGE_CODE=en-IN

# NOTE: DATABASE_URL is not set here because there is no line for it in the
# real .env this file mirrors - it is optional and defaults to
# sqlite:///./tis_app.db (app/db/session.py:18), a path RELATIVE TO THE
# PROCESS WORKING DIRECTORY. Starting uvicorn from any folder other than the
# repo root silently creates a new, empty database there instead of reusing
# the one alembic/seed_demo built. Always start uvicorn from the repo root.
